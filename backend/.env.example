# Copy to .env and fill placeholders. No real credentials in this file.
DATABASE_URL=mysql+pymysql://<user>:<url-encoded-password>@<db-host>:<port>/<database>?charset=utf8mb4
CORS_ORIGINS=["<frontend-origin>"]
ENVIRONMENT=development
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PAYMENTS_ENABLED=false
REFUNDS_ENABLED=false
CULTURE_API_KEY=
MONGO_URI=mongodb://<user>:<url-encoded-password>@<mongo-host>:<port>/?authSource=admin
MONGO_DATABASE=culturepick_events
MONGO_COLLECTION=events
# Optional: verified public upstream endpoints have built-in defaults.
# PORTONE_API_BASE_URL=https://api.portone.io
# CULTURE_API_BASE_URL=https://apis.data.go.kr/B553457/nopenapi/rest/publicperformancedisplays
