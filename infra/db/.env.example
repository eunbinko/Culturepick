# Generate a private copy with: python scripts/create_env.py
COMPOSE_PROJECT_NAME=culturepick
DB_BIND_ADDRESS=127.0.0.1
MARIADB_PORT=3306
MONGODB_PORT=27017
MARIADB_IMAGE=mariadb:11.8
MONGODB_IMAGE=mongo:8.0
MARIADB_ROOT_PASSWORD=replace-root-password
MARIADB_MIGRATION_PASSWORD=replace-migration-password
MARIADB_APP_PASSWORD=replace-app-password
MARIADB_COLLECTOR_PASSWORD=replace-collector-password
MARIADB_DISPATCHER_PASSWORD=replace-dispatcher-password
MARIADB_ANALYTICS_PASSWORD=replace-analytics-password
MARIADB_BACKUP_PASSWORD=replace-backup-password
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=replace-mongo-root-password
MONGO_APP_PASSWORD=replace-mongo-app-password
MONGO_DISPATCHER_PASSWORD=replace-mongo-dispatcher-password
MONGO_ANALYTICS_PASSWORD=replace-mongo-analytics-password
MONGO_BACKUP_PASSWORD=replace-mongo-backup-password
